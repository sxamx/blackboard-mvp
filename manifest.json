{
  "manifest_version": 3,
  "name": "Detector de clases Blackboard Duoc",
  "version": "0.10.3",
  "description": "Detecta y descarga archivos de Blackboard por clase, en carpetas o ZIP.",
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Detectar clases y archivos",
    "default_popup": "popup.html"
  }
}
